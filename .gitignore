# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sources lourdes, non déployées :
# - photos originales → sélection optimisée dans public/assets/photos (scripts/export-photos.py)
# - export brut du plan 3D → version servie dans public/visite-3d/plan.html (scripts/build-plan.py)
/public/assets/photos-all/
/public/assets/3D-view/

# python
__pycache__/
